#
# Panel variant overlay: 10.1" 1280x800 (Guition JC8012P4A1C).
# Apply together with the common sdkconfig.defaults via
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.panel10jc" ...
# or the CMake preset "panel10jc" (see CMakePresets.json).

# --- Panel variant selector (drives app_config.h + display/touch init) ---
# CONFIG_APP_PANEL_VARIANT_4INCH_720 is not set
CONFIG_APP_PANEL_VARIANT_10INCH_JC=y

# PSRAM profile (Hex 200MHz) and the shared display/LVGL tuning (including
# CONFIG_BSP_LCD_DPI_BUFFER_NUMS etc.) live in sdkconfig.defaults.  The BSP_*
# symbols are provided by the local components/jc8012_bsp Kconfig shim.

# --- GSL3680 touch tuning ---
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=10

# --- TCP receive pacing (STA TX DMA exhaustion fix) ---
# Keep the same value as the common defaults; explicit here so any future
# bump in sdkconfig.defaults cannot re-introduce the ACK flood on this panel.
CONFIG_LWIP_TCP_WND_DEFAULT=4096

# --- UI assets ---
CONFIG_LV_USE_LODEPNG=y

# --- FATFS: enable Long File Names ---
# Tile background uploads use the original (often long) filename from the
# browser, e.g. "screenshot_2025.png". With LFN disabled (the default) only
# 8.3 names can be created and every such upload fails with
# "Cannot open target file". Use heap-allocated LFN buffers so long names
# work without growing every task stack.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# --- 16MB BOYA flash + ESP32-P4 rev v1.x (this JC panel) ---
# The common sdkconfig.defaults targets 32MB boards; the JC8012P4A1C has
# 16MB flash and silicon revision v1.x, so override both here.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.16mb.csv"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# --- Feature toggles for the JC panel ---
# Xiaozhi voice assistant is enabled (ES8311 mono mic + speaker).
# Remote camera store (web editor cameras page) is enabled so /api/cameras
# is served; the JC panel has no RTSP cameras but the web UI still polls it.
# The built-in OV02C10 MIPI-CSI camera is ENABLED.  Its start was moved to a
# dedicated boot task (app_main.c) so the 8KB main task stack is no longer
# exhausted during dashboard init (the original bootloop cause).
CONFIG_APP_FEATURE_CAMERAS=y
CONFIG_APP_FEATURE_XIAOZHI=y
CONFIG_APP_FEATURE_LOCAL_CAMERA=y

# --- Built-in OV02C10 MIPI-CSI camera: enabled ---
# 1288x728 (native OV02C10 16:9 crop) instead of 1920x1080: ~2.2x less MIPI
# bandwidth and half the PSRAM per capture buffer. 1080p + ESP-Hosted WiFi
# exhausts the internal DMA heap ("STA TX buffer alloc failed") and eventually
# PANICs; 1288x728 is also a near-native fit for the 1280x800 panel.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1288X728_30FPS=y
CONFIG_CAMERA_OV02C10_MIPI_DEFAULT_FMT_RAW10_1288X728_30FPS=y

# --- ESP Video framework (V4L2 MIPI-CSI stack): enabled with the camera ---
# The video device registers a /dev/videoX VFS node; the panel already mounts
# several filesystems (FATFS SD, web assets, etc.), so the default 8 VFS slots
# are exhausted and esp_video_init fails with
# "Failed to register video VFS dev name=video0".  Bump the limit (esp_video's
# own examples use 10-16).
CONFIG_VFS_MAX_COUNT=16
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
# The ISP pipeline controller is what binds the MIPI-CSI device to the ISP on
# ESP32-P4: without it the RAW10 OV02C10 frames are never converted to RGB565
# and /dev/video0 delivers no frames (camera "running" but never ready).
# esp_video's own ESP32-P4 examples enable this.
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_ESP_VIDEO_ENABLE_DATA_PREPROCESSING=n
CONFIG_ESP_VIDEO_DISABLE_MIPI_CSI_DRIVER_BACKUP_BUFFER=y
CONFIG_ESP_VIDEO_ENABLE_SWAP_SHORT=n
CONFIG_ESP_VIDEO_ENABLE_SWAP_BYTE=n
